# ── ddg-search-mcp configuration ──
# All variables are optional — defaults are shown below.

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
DDG_LOG_LEVEL=INFO

# Delay in seconds between search requests (default: 3.0)
DDG_SEARCH_DELAY=3.0

# Max characters of page content to return per result (default: 6000)
DDG_MAX_CONTENT_CHARS=6000

# Max characters of snippet to show when page fetch fails (default: 400)
DDG_MAX_SNIPPET_CHARS=400

# Page fetch timeout in seconds (default: 8.0)
DDG_PAGE_FETCH_TIMEOUT=8.0

# Search request timeout in seconds (default: 12.0)
DDG_SEARCH_TIMEOUT=12.0

# Max results per search query (default: 10)
DDG_MAX_RESULTS=10
